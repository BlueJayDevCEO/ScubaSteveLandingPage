# Server-only Firebase Admin credentials for /api/early-access and /api/business-interest.
# Set these in Vercel Project Settings > Environment Variables.
#
# Preferred:
ADMIN_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com"}
#
# Alternative split values:
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Enquiry email notifications (Resend). Every form submission on any channel is
# emailed to the enquiry inbox in addition to being stored in Firestore.
# If RESEND_API_KEY is unset, sending is skipped (leads still save to Firestore).
#
# RESEND_API_KEY: create at https://resend.com and verify the scubasteve.rocks
# domain so ENQUIRY_FROM can send from it.
RESEND_API_KEY=re_...
# Where enquiries are delivered (default steve@scubasteve.rocks if unset):
ENQUIRY_EMAIL=steve@scubasteve.rocks
# From address — must be on a domain verified in Resend:
ENQUIRY_FROM="Scuba Steve <steve@scubasteve.rocks>"
